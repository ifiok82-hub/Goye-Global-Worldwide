{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/validation-key.txt", "destination": "/validation-key.txt" },
    { "source": "/.well-known/validation-key.txt", "destination": "/.well-known/validation-key.txt" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!validation-key\\.txt|\\.well-known|api/|.*\\..*).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/validation-key.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/.well-known/validation-key.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
